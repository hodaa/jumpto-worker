# Base URL of the JumpTo backend internal API
BACKEND_URL=http://localhost:8000
# Shared API key matching the backend's INTERNAL_API_KEY
INTERNAL_API_KEY=changeme
# Queue provider (Celery broker): redis or rabbitmq
QUEUE_PROVIDER=redis
# Redis used as the Celery broker (when QUEUE_PROVIDER=redis)
REDIS_URL=redis://localhost:6379/0
# RabbitMQ used as the Celery broker (when QUEUE_PROVIDER=rabbitmq)
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
# Celery app/task namespace; must match producer task names (default "jumpto")
CELERY_APP_NAME=jumpto
# Celery worker concurrency
CELERY_WORKER_CONCURRENCY=8
# Tasks a prefork child may run before it is replaced (bounds RSS growth)
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
# Max seconds a transcription job may run before it is failed
JOB_TIMEOUT_SECONDS=600
# Extra hard time-limit margin for cleanup after a timeout
TASK_TIMEOUT_GRACE_SECONDS=30
# Assembly.ai API key for audio transcription
ASSEMBLY_API_KEY=
# Audio transcription provider used when captions are missing (yt-dlp provider):
# deepgram (default) or assembly
SPEECH_TO_TEXT_PROVIDER=deepgram
# Deepgram API key for audio transcription (used when SPEECH_TO_TEXT_PROVIDER=deepgram)
DEEPGRAM_API_KEY=
# Deepgram API base URL (optional override)
DEEPGRAM_API_URL=https://api.deepgram.com/v1
# Optional public base URL the backend exposes for Assembly.ai completion
# callbacks (e.g. https://jumpto-backend.vercel.app/api/webhooks/assembly).
# When set, the worker submits transcripts with job context appended and ends
# the task instead of poller-retrying; empty uses the in-worker retry loop.
ASSEMBLY_WEBHOOK_BASE_URL=
# Enable live external calls (yt-dlp, Assembly.ai, Deepgram)
LIVE_EXTERNAL_CALLS=true
# Single transcript provider used for every job; only this provider runs and if
# it fails the job errors instead of falling back. Default yt-dlp (free, local).
# e.g. VIDEO_PROVIDER=vidwords
VIDEO_PROVIDER=yt-dlp
YTDLP_BGUTIL_URL=http://127.0.0.1:4416
# Socket timeout for yt-dlp network requests (seconds)
YTDLP_SOCKET_TIMEOUT=30
# Disk-backed worker transcript cache (SQLite, no external service required)
TRANSCRIPT_CACHE_ENABLED=true
# Directory where cached transcripts are stored
TRANSCRIPT_CACHE_DIRECTORY=/var/tmp/jumpto-transcript-cache
# How long a cached transcript stays valid (seconds)
TRANSCRIPT_CACHE_TTL_SECONDS=86400
# Max time a worker holds the per-video cache lock
TRANSCRIPT_CACHE_LOCK_TTL_SECONDS=900
ENVIRONMENT=development
