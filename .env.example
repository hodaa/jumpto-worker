# Base URL of the JumpTo backend internal API
BACKEND_URL=http://localhost:8000
# Shared API key matching the backend's INTERNAL_API_KEY
INTERNAL_API_KEY=changeme
# Queue provider (Celery broker): redis or rabbitmq
QUEUE_PROVIDER=redis
# Redis used as the Celery broker (when QUEUE_PROVIDER=redis)
REDIS_URL=redis://localhost:6379/0
# RabbitMQ used as the Celery broker (when QUEUE_PROVIDER=rabbitmq)
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
# Celery worker concurrency
CELERY_WORKER_CONCURRENCY=8
# Max seconds a transcription job may run before it is failed
JOB_TIMEOUT_SECONDS=600
# Assembly.ai API key for audio transcription
ASSEMBLY_API_KEY=
# Enable live external calls (yt-dlp, Assembly.ai)
JUMPTO_LIVE_EXTERNAL_CALLS=true
# Transcript mode: real or fake
JUMPTO_TRANSCRIPT_MODE=real
# Default transcript provider used first (empty = standard order: transcriptfetch,
# supadata, vidwords, yt-dlp). e.g. DEFAULT_VIDEO_PROVIDER=yt-dlp
 DEFAULT_VIDEO_PROVIDER=
YTDLP_PROXY=
YTDLP_BGUTIL_URL=http://127.0.0.1:4416
# Socket timeout for yt-dlp network requests (seconds)
YTDLP_SOCKET_TIMEOUT=30
# Redis-backed worker transcript cache (uses REDIS_URL above)
TRANSCRIPT_CACHE_ENABLED=true
# How long a cached transcript stays valid (seconds)
TRANSCRIPT_CACHE_TTL_SECONDS=86400
ENVIRONMENT=development
