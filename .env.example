# Base URL of the JumpTo backend internal API
BACKEND_URL=http://localhost:8000
# Shared API key matching the backend's INTERNAL_API_KEY
INTERNAL_API_KEY=changeme
# Redis used as the Celery broker
REDIS_URL=redis://localhost:6379/0
# Celery worker concurrency
CELERY_WORKER_CONCURRENCY=8
# Max seconds a transcription job may run before it is failed
JOB_TIMEOUT_SECONDS=600
# Assembly.ai API key for audio transcription
ASSEMBLY_API_KEY=
# Enable live external calls (yt-dlp, Assembly.ai)
JUMPTO_LIVE_EXTERNAL_CALLS=true
# Transcript mode: real or fake
JUMPTO_TRANSCRIPT_MODE=real
# Optional HTTP(S)/SOCKS proxy for yt-dlp (e.g. residential gateway to avoid
# YouTube bot-blocks on datacenter IPs)
# YTDLP_PROXY=
# Optional bgutil PO-token provider base URL for yt-dlp (keeps YouTube from
# bot-challenging/LOGIN_REQUIRED on datacenter IPs). In Docker compose this
# defaults to the bgutil-pot service via the YTDLP_BGUTIL_URL override.
# YTDLP_BGUTIL_URL=http://127.0.0.1:4416
# Environment: development or production
ENVIRONMENT=development
